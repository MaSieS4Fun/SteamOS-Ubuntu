# Block Ubuntu stock Mesa forever — vendor Mesa (SM8550 Turnip) owns the GL/VK stack.
# Dummy packages (99:26.1.6-sm8550vendor1) keep apt consistent; this pin
# prevents Discover/apt from pulling Ubuntu 26.0.x back over them.
Package: libegl-mesa0
Pin: release *
Pin-Priority: -1

Package: libegl-mesa0:*
Pin: release *
Pin-Priority: -1

