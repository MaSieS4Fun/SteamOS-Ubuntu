#!/usr/bin/env bash
set -euo pipefail

STEAM_SET_SESSION=/usr/lib/steamos/steam-set-session
SESSION_DIR=/var/lib/steamos-ubuntu
LOG=/var/log/steamos-session.log

log() {
  printf 'steamos-session-select: %s\n' "$*" | tee -a "$LOG" >&2 2>/dev/null \
    || printf 'steamos-session-select: %s\n' "$*" >&2
}

set_session() {
  local target="$1"

  if [[ -w "$SESSION_DIR" ]] || [[ -w "${SESSION_DIR}/session" ]]; then
    bash "$STEAM_SET_SESSION" "$target"
    return 0
  fi

  if [[ -f "$STEAM_SET_SESSION" ]] && command -v pkexec >/dev/null 2>&1; then
    pkexec bash "$STEAM_SET_SESSION" "$target" && return 0
  fi

  if [[ -f "$STEAM_SET_SESSION" ]]; then
    bash "$STEAM_SET_SESSION" "$target" && return 0
  fi

  log "ERROR: cannot write session"
  exit 1
}

steam_shutdown() {
  if [[ -x /home/steam/.local/share/Steam/steamrtarm64/steam ]]; then
    /home/steam/.local/share/Steam/steamrtarm64/steam -shutdown >/dev/null 2>&1 || true
  fi
}

apply_desktop_pad() {
  if [[ -x /usr/bin/gyro-desktop-plasma ]]; then
    log "Desktop pad: gamepad-only + optional DSU state"
    sudo -n /usr/bin/gyro-desktop-plasma 2>/dev/null || \
      /usr/bin/gyro-desktop-plasma 2>/dev/null || true
  fi
}

apply_gaming_pad() {
  if [[ -x /usr/bin/gyro-desktop-gamescope ]]; then
    log "Gaming Mode pad: deck-uhid + IMU"
    sudo -n /usr/bin/gyro-desktop-gamescope 2>/dev/null || \
      /usr/bin/gyro-desktop-gamescope 2>/dev/null || true
  fi
}

current_session() {
  cat "${SESSION_DIR}/session" 2>/dev/null || true
}

nested_gm_running() {
  pgrep -f 'steamos-desktop-gamescope|gyro-desktop-nested-gm' >/dev/null 2>&1
}

nested_gm_startup_grace() {
  local marker="/run/user/1000/nested-gm-launch.ts" now start age
  [[ -f "$marker" ]] || return 1
  nested_gm_running || return 1
  now=$(date +%s)
  start=$(cat "$marker" 2>/dev/null || echo 0)
  age=$((now - start))
  (( age >= 0 && age < 180 ))
}

case "${1:-}" in

  plasma|desktop|kde)
    # Nested Desktop GM under Plasma: session file may still say gamescope-session.
    if nested_gm_running; then
      if nested_gm_startup_grace; then
        log "Switch to Desktop: nested GM starting — skip steam_shutdown"
        set_session plasma.desktop
        apply_desktop_pad
        exit 0
      fi
      log "Switch to Desktop: shutting down nested Steam"
      steam_shutdown
      set_session plasma.desktop
      apply_desktop_pad
      exit 0
    fi

    if [[ "$(current_session)" == "plasma" ]]; then
      if pgrep -f '/steamrtarm64/steam' >/dev/null 2>&1; then
        log "Switch to Desktop: shutting down Steam on Plasma"
        steam_shutdown
      else
        log "Switch to Desktop: already on Plasma"
      fi
      apply_desktop_pad
      exit 0
    fi

    log "Switch to Desktop: selecting Plasma (from gamescope-session)"
    set_session plasma.desktop
    log "Switch to Desktop: shutting down Steam"
    steam_shutdown
    apply_desktop_pad
    ;;

  gamescope|gamepadui|steam)
    log "Switch to Gaming Mode: selecting Gamescope"
    set_session gamescope-session.desktop
    apply_gaming_pad

    if command -v qdbus6 >/dev/null 2>&1; then
        qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null || true
    elif command -v qdbus >/dev/null 2>&1; then
        qdbus org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null || true
    else
        loginctl terminate-session "$XDG_SESSION_ID" 2>/dev/null || true
    fi
    ;;

  oneshot)
    set_session gamescope-session.desktop
    apply_gaming_pad
    log "oneshot: Gaming Mode"
    ;;

  persistent)
    set_session gamescope-session.desktop
    apply_gaming_pad
    log "persistent: Gaming Mode"
    ;;

  *)
    echo "Usage: $0 {plasma|gamescope|oneshot}"
    exit 1
    ;;

esac
