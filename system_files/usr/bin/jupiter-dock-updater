#!/usr/bin/env bash
# No Valve Dock on SM8550 — Steam still probes this helper on update checks.
#
# Semantics (Valve jupiter-dock-updater-mock.sh + Steam systemdockmanager):
#   --check exit 0     → update available (Steam tries apply → blocks other updates)
#   --check exit 7     → up to date
#   missing binary     → exit 127 → SteamUI "Error de actualización"
#   version < 0.13.15.106 → "unsupported firmware" → Updater check error: 40
#     and SetForceInternalDisplay=1
#
# Report a known-good equal current/available pair so Steam treats dock as
# fine and does not prompt or fail the Software Updates check.
set -uo pipefail

# From Valve dock firmware line (must be >= 0.13.15.106 per Steam client).
FW_VER="0.13.15.124"

for arg in "$@"; do
  case "$arg" in
    --check)
      echo "FW Current: ${FW_VER}"
      echo "FW Available: ${FW_VER}"
      echo "FW up to date"
      exit 7
      ;;
  esac
done

# Apply path: no-op (should not run when check returns 7).
exit 0
