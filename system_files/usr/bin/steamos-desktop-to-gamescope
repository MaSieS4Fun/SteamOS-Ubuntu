#!/usr/bin/env bash
# Reliable Gaming Mode from Plasma Desktop.
#
# Nested `gamescope -e -- steam …` under KWin is flaky (DRM ABRT), especially
# while Decky PluginLoader (x86_64 via FEX) is running. Prefer the same path as
# a working gaming session: write the session file and leave Plasma so greetd
# starts /usr/bin/gamescope-session.
set +e

LOG=/var/log/steamos-session.log
log() {
  printf 'desktop-to-gamescope: %s\n' "$*"
  printf 'desktop-to-gamescope: %s\n' "$*" >>"$LOG" 2>/dev/null || true
}

if command -v notify-send >/dev/null 2>&1; then
  notify-send -a "SteamOS" "Gaming Mode" "Switching to gamescope session…" 2>/dev/null || true
fi

log "requested from Desktop (uid=$(id -u))"

# Do not thrash PluginLoader here — gamescope-session will ensure :1337.
if [[ -x /usr/bin/steamos-session-select ]]; then
  exec /usr/bin/steamos-session-select gamescope
fi

log "ERROR: steamos-session-select missing"
exit 1
