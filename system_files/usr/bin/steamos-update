#!/usr/bin/env bash
# Steam UI OS-update hook — Steam Deck semantics on a mutable Ubuntu image.
#
# Calls:
#   steamos-update --supports-duplicate-detection   → capability probe (exit 0)
#   steamos-update --enable-duplicate-detection     → APPLY
#   steamos-update … check                          → is an OS update available?
#
# Exit codes:
#   0 = success / update available / apply ok
#   7 = no update / nothing to apply
#
# This image has no RAUC/atomupd OS payloads:
#   - check always exits 7 (no update). Exit 0 falsely advertises an update;
#     Steam then Apply → "system restart required" → can brick the session.
#   - APPLY exits 0 only during OOBE (stamp CompletedOOBE + nudge Steam).
#     After login, APPLY exits 7 so we never claim a reboot-needed OS update.
#
# Note: check→7 is correct (up to date). Residual SteamUI "Updater check
# error: 40" came from BootStrapperInhibitAll → Client eresult Blocked; fixed
# by patch-steamui-update-check. check→0 is NOT safe (fake OS update).
set -uo pipefail

STEAM_HOME="${STEAM_HOME:-/home/steam}"
LOGINUSERS="${STEAM_HOME}/.local/share/Steam/config/loginusers.vdf"
MARKER=/var/lib/steamos-ubuntu/oobe-os-update-acked
REG_STEAM="${STEAM_HOME}/.steam/registry.vdf"
REG_LOCAL="${STEAM_HOME}/.local/share/Steam/registry.vdf"

mark_oobe_complete() {
  python3 - "$@" <<'PY' 2>/dev/null || true
import pathlib, re, sys

WANT = (("CompletedOOBE", "1"), ("CompletedOOBEStage1", "1"))
DROP = ("ForceOOBE", "ForceOOBEStage2")

def upsert(path: pathlib.Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
    if '"Steam"' not in text:
        lines = "\n".join(f'\t\t\t\t\t"{k}"\t\t"{v}"' for k, v in WANT)
        text = (
            '"Registry"\n{\n\t"HKCU"\n\t{\n\t\t"Software"\n\t\t{\n'
            '\t\t\t"Valve"\n\t\t\t{\n\t\t\t\t"Steam"\n\t\t\t\t{\n'
            f"{lines}\n"
            "\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n"
        )
        path.write_text(text, encoding="utf-8")
        return

    for k in DROP:
        text = re.sub(r'^[ \t]*"' + re.escape(k) + r'"[ \t]*"[^"]*"[ \t]*\n', "", text, flags=re.M)

    m = re.search(
        r'("HKCU"\s*\{.*?^[ \t]*"Steam"\s*\n[ \t]*\{)',
        text,
        flags=re.M | re.S,
    )
    if not m:
        m = re.search(r'(^[ \t]*"Steam"\s*\n[ \t]*\{)', text, flags=re.M)
    if not m:
        path.write_text(text, encoding="utf-8")
        return

    head_end = m.end()
    i = head_end
    depth = 1
    while i < len(text) and depth:
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
        i += 1
    block = text[head_end : i - 1]
    indent = "\t\t\t\t\t"
    child = re.search(r'\n([ \t]+)"', "\n" + block)
    if child:
        indent = child.group(1)

    for k, v in WANT:
        pat = r'^[ \t]*"' + re.escape(k) + r'"[ \t]*"[^"]*"'
        if re.search(pat, block, flags=re.M):
            block = re.sub(pat, f'"{k}"\t\t"{v}"', block, count=1, flags=re.M)
            block = re.sub(
                r'^"' + re.escape(k) + r'"\t\t"' + re.escape(v) + r'"',
                f'{indent}"{k}"\t\t"{v}"',
                block,
                count=1,
                flags=re.M,
            )
        else:
            block = f'\n{indent}"{k}"\t\t"{v}"' + (block if block.startswith("\n") else "\n" + block)

    text = text[:head_end] + block + text[i - 1 :]
    path.write_text(text, encoding="utf-8")

for p in sys.argv[1:]:
    upsert(pathlib.Path(p))
PY
}

for arg in "$@"; do
  case "$arg" in
    --supports-duplicate-detection) exit 0 ;;
  esac
done

check=0
for arg in "$@"; do
  case "$arg" in
    check) check=1 ;;
  esac
done

if [[ "$check" -eq 1 ]]; then
  exit 7
fi

oobe=0
if [[ ! -f "$LOGINUSERS" ]] || ! grep -qs '"AccountName"' "$LOGINUSERS"; then
  oobe=1
fi

# Post-login Apply: do not claim success (Steam → "restart required" hang).
if [[ "$oobe" -eq 0 ]]; then
  exit 7
fi

mkdir -p /var/lib/steamos-ubuntu 2>/dev/null || true
mark_oobe_complete "$REG_STEAM" "$REG_LOCAL"
if [[ ! -f "$MARKER" ]]; then
  touch "$MARKER" 2>/dev/null || true
  (
    sleep 2
    pkill -f '/home/steam/\.local/share/Steam/steamrtarm64/steam' 2>/dev/null \
      || pkill -f 'steamrtarm64/steam' 2>/dev/null \
      || true
    sleep 1
    mark_oobe_complete "$REG_STEAM" "$REG_LOCAL"
  ) &
fi

exit 0
