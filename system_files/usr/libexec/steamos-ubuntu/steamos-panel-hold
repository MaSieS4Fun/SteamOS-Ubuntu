#!/usr/bin/env bash
# Keep the panel obviously alive until gamescope takes DRM.
# An OLED stays fully black if the console is cleared and printk is silenced.
set +e

MARKER="${PANEL_HOLD_MARKER:-/run/steamos-ubuntu/panel-hold.active}"
TTY=/dev/tty1

unblank() {
  local bl max fb
  printf '\033[9;0]\033[?25l' >"$TTY" 2>/dev/null || true
  for fb in /sys/class/graphics/fb*/blank; do
    [[ -w "$fb" ]] || continue
    echo 0 >"$fb" 2>/dev/null || true
  done
  for bl in /sys/class/backlight/*/brightness; do
    [[ -w "$bl" ]] || continue
    max="${bl%/brightness}/max_brightness"
    [[ -r "$max" ]] || continue
    cat "$max" >"$bl" 2>/dev/null || true
  done
}

draw() {
  local spin="$1"
  unblank
  printf '\033[2J\033[H\n\n\n      SteamOS-Ubuntu\n\n      Starting %s\n\n' "$spin" >"$TTY" 2>/dev/null || true
}

hold() {
  local frames='|/-\' i=0
  mkdir -p /run/steamos-ubuntu 2>/dev/null || true
  chmod 0775 /run/steamos-ubuntu 2>/dev/null || true
  touch "$MARKER" 2>/dev/null || true
  chmod 0666 "$MARKER" 2>/dev/null || true
  [[ -w /proc/sys/kernel/printk ]] && echo "4 4 1 4" >/proc/sys/kernel/printk 2>/dev/null || true
  while [[ -f "$MARKER" ]]; do
    draw "${frames:i++%4:1}"
    sleep 0.4
  done
}

release() {
  rm -f "$MARKER" 2>/dev/null || true
  printf '\033[?25h\033[2J\033[H' >"$TTY" 2>/dev/null || true
}

case "${1:-}" in
  hold|start) hold ;;
  release|stop) release ;;
  *)
    echo "Usage: $0 hold|release" >&2
    exit 2
    ;;
esac
