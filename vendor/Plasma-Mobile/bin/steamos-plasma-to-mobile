#!/usr/bin/env bash
# Plasma Desktop → Plasma Mobile (logout desktop, greetd starts mobile).
set +e

END_SESSION=/usr/share/plasma-mobile-steamos/bin/steamos-plasma-end-session.sh
LOG=/var/log/steamos-session.log
SESSION_FILE=/var/lib/steamos-ubuntu/session
HANDOFF=/var/lib/steamos-ubuntu/plasma-handoff

log() {
  printf 'plasma-to-mobile: %s\n' "$*"
  printf 'plasma-to-mobile: %s\n' "$*" >>"$LOG" 2>/dev/null || true
}

if ! command -v startplasmamobile >/dev/null 2>&1; then
  notify-send -a "SteamOS" "Plasma Mobile" "Not installed" 2>/dev/null || true
  exit 1
fi
if [[ ! -x /usr/share/plasma-mobile-steamos/launch-plasma-mobile.sh ]]; then
  log "ERROR: run sudo install-plasma-mobile"
  exit 1
fi
if [[ ! -x "$END_SESSION" ]]; then
  log "ERROR: missing $END_SESSION — re-run install-plasma-mobile"
  exit 1
fi

notify-send -a "SteamOS" "Plasma Mobile" "Switching to mobile shell…" 2>/dev/null || true

set_session() {
  local dir=/var/lib/steamos-ubuntu
  if [[ -w "$dir" || -w "${dir}/session" ]]; then
    bash /usr/lib/steamos/steam-set-session "$1"
  else
    pkexec bash /usr/lib/steamos/steam-set-session "$1"
  fi
}

read_session() { tr -d '[:space:]' <"$SESSION_FILE" 2>/dev/null || true; }

log "requested was=$(read_session)"
set_session plasma-mobile.desktop || exit 1
[[ "$(read_session)" == "plasma-mobile" ]] || { log "ERROR: session not plasma-mobile"; exit 1; }

touch "$HANDOFF" 2>/dev/null || pkexec touch "$HANDOFF" 2>/dev/null || true
log "session → plasma-mobile, ending Plasma session"
exec "$END_SESSION"
