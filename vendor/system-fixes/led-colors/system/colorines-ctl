#!/usr/bin/env python3
"""CLI bridge for Colorines (KDE applet, Plasma Mobile QS, scripts)."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

_REPO_SHARED = Path(__file__).resolve().parents[1] / "shared"
if _REPO_SHARED.is_dir():
    sys.path.insert(0, str(_REPO_SHARED))

from colorines import leds  # noqa: E402


def _out(data) -> int:
    print(json.dumps(data, ensure_ascii=False))
    return 0


def _err(msg: str, code: int = 1) -> int:
    print(json.dumps({"ok": False, "error": msg}), file=sys.stderr)
    print(msg, file=sys.stderr)
    return code


def _needs_elevation() -> bool:
    if os.geteuid() == 0:
        return False
    if os.environ.get("COLORINES_NO_SUDO") == "1":
        return False
    zones = leds.discover_zones()
    if not zones:
        return False
    zdir = leds._zone_dir(zones[0])  # noqa: SLF001
    if zdir is None:
        return False
    path = zdir / "brightness"
    try:
        # Probe without changing value
        cur = path.read_text()
        path.write_text(cur if cur.endswith("\n") else cur + "\n")
        return False
    except OSError:
        return True


def _elevate_if_needed() -> None:
    """Re-exec via sudo -n when sysfs is not writable for this user."""
    if not _needs_elevation():
        if os.geteuid() == 0:
            leds._ensure_sysfs_writable()  # noqa: SLF001
        return
    ctl = str(Path(__file__).resolve())
    if not shutil.which("sudo"):
        raise RuntimeError("LED sysfs not writable and sudo is missing")
    env = os.environ.copy()
    env["COLORINES_NO_SUDO"] = "1"
    result = subprocess.run(
        ["sudo", "-n", ctl, *sys.argv[1:]],
        env=env,
        check=False,
    )
    raise SystemExit(result.returncode)


def _parse_zones(args: list[str]) -> tuple[list[str], list[str] | None]:
    zones = None
    rest: list[str] = []
    i = 0
    while i < len(args):
        if args[i] in ("--zone", "-z") and i + 1 < len(args):
            raw = args[i + 1]
            zones = [z.strip() for z in raw.split(",") if z.strip() and z.strip() != "all"]
            if not zones:
                zones = None
            i += 2
            continue
        rest.append(args[i])
        i += 1
    return rest, zones


def cmd_status(_args: list[str]) -> int:
    return _out(leds.get_state())


def cmd_get(_args: list[str]) -> int:
    return _out(leds.get_state())


def cmd_off(args: list[str]) -> int:
    _elevate_if_needed()
    _rest, zones = _parse_zones(args)
    return _out(leds.set_off(zones=zones))


def cmd_on(args: list[str]) -> int:
    _elevate_if_needed()
    _rest, zones = _parse_zones(args)
    return _out(leds.set_on(zones=zones))


def cmd_toggle(args: list[str]) -> int:
    _elevate_if_needed()
    _rest, zones = _parse_zones(args)
    return _out(leds.toggle(zones=zones))


def cmd_cycle(args: list[str]) -> int:
    _elevate_if_needed()
    _rest, zones = _parse_zones(args)
    return _out(leds.cycle(zones=zones))


def cmd_set(args: list[str]) -> int:
    _elevate_if_needed()
    rest, zones = _parse_zones(args)
    brightness = None
    cleaned: list[str] = []
    i = 0
    while i < len(rest):
        if rest[i] in ("--brightness", "-b") and i + 1 < len(rest):
            brightness = int(rest[i + 1])
            i += 2
            continue
        cleaned.append(rest[i])
        i += 1
    if len(cleaned) == 1 and cleaned[0].startswith("#") and len(cleaned[0]) == 7:
        h = cleaned[0][1:]
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    elif len(cleaned) >= 3:
        r, g, b = int(cleaned[0]), int(cleaned[1]), int(cleaned[2])
    else:
        return _err("usage: colorines-ctl set R G B [--brightness N]")
    return _out(leds.set_color(r, g, b, brightness=brightness, zones=zones))


def cmd_preset(args: list[str]) -> int:
    _elevate_if_needed()
    rest, zones = _parse_zones(args)
    if not rest:
        return _err("usage: colorines-ctl preset NAME")
    return _out(leds.apply_preset(rest[0], zones=zones))


def cmd_presets(_args: list[str]) -> int:
    return _out({"presets": leds.preset_catalog()})


COMMANDS = {
    "status": cmd_status,
    "get": cmd_get,
    "set": cmd_set,
    "off": cmd_off,
    "on": cmd_on,
    "toggle": cmd_toggle,
    "cycle": cmd_cycle,
    "preset": cmd_preset,
    "presets": cmd_presets,
}


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(
            "colorines-ctl — gamepad RGB LEDs\n"
            "  status | get\n"
            "  on | off | toggle | cycle\n"
            "  preset NAME | presets\n"
            "  set R G B\n",
            file=sys.stderr,
        )
        return 0
    cmd = argv[0]
    if cmd not in COMMANDS:
        return _err(f"unknown command: {cmd}")
    try:
        return COMMANDS[cmd](argv[1:])
    except SystemExit as exc:
        return int(exc.code or 0)
    except Exception as exc:  # noqa: BLE001
        return _err(str(exc))


if __name__ == "__main__":
    raise SystemExit(main())
