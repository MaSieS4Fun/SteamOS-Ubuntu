From: MaSi <noreply@masi.local>
Subject: [PATCH] PM: keep the stuck device name in the free SDAM tail

The zero tail of pmk8550 SDAM 2 did not retain the device name
across the watchdog reboot. Prove the write sticks before using
it, and fall back to the zero gap at offset 0x05.

---
--- a/drivers/base/power/main.c
+++ b/drivers/base/power/main.c
@@ -39,6 +39,10 @@
 #include <linux/nmi.h>
 #include <linux/fs.h>
 #include <linux/kthread.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
 
 #include "../base.h"
 #include "power.h"
@@ -587,10 +591,11 @@
 subsys_initcall(dpm_watchdog_sysctl_init);
 
 /*
- * Qualcomm's boot path wipes DDR, so the panic text never reaches pstore.
- * /boot is the vfat kernel partition; a nofreeze thread can append there
- * once storage has resumed, which is before the devices that hang after
- * the gamepad LEDs come back.
+ * Qualcomm's boot path wipes DDR, and a write to /boot during the hang
+ * never reaches the card: the block layer is on the same resume path.
+ * pmk8550 SDAM 2 at 0x80 is live in the first 0x12 bytes (they change
+ * every boot). The tail from 0x14 stayed zero across a watchdog reboot,
+ * so the name goes only there. The next boot prints "previous DPM timeout".
  */
 static char dpm_stuck_msg[160];
 static DECLARE_WAIT_QUEUE_HEAD(dpm_stuck_wait);
@@ -598,6 +603,20 @@
 static struct task_struct *dpm_stuck_task;
 static struct timer_list dpm_stuck_panic_timer;
 static atomic_t dpm_stuck_panicked = ATOMIC_INIT(0);
+static bool dpm_stuck_sdam_checked;
+static bool dpm_stuck_sdam_spare;
+static unsigned int dpm_stuck_slot_off;
+static unsigned int dpm_stuck_slot_len;
+
+#define DPM_STUCK_SDAM_BASE	0x7100
+#define DPM_STUCK_SDAM_OFF	0x80
+#define DPM_STUCK_SDAM_LEN	48
+#define DPM_STUCK_SDAM_REG	(DPM_STUCK_SDAM_BASE + DPM_STUCK_SDAM_OFF)
+/* 0x00-0x04 and 0x10-0x11 change every boot. 0x05-0x0f and 0x14-0x2f were zero. */
+#define DPM_STUCK_SDAM_GAP	0x05
+#define DPM_STUCK_SDAM_GAP_LEN	11
+#define DPM_STUCK_SDAM_TAIL	0x14
+#define DPM_STUCK_SDAM_TAIL_LEN	(DPM_STUCK_SDAM_LEN - DPM_STUCK_SDAM_TAIL)
 
 static void dpm_stuck_do_panic(void)
 {
@@ -610,8 +629,162 @@
 	dpm_stuck_do_panic();
 }
 
+static struct regmap *dpm_stuck_sdam_map(void)
+{
+	struct device_node *np = NULL;
+	struct platform_device *pdev;
+	struct regmap *map;
+	u32 reg;
+
+	for (;;) {
+		struct device_node *parent;
+
+		np = of_find_compatible_node(np, NULL, "qcom,spmi-sdam");
+		if (!np)
+			return NULL;
+		parent = of_get_parent(np);
+		if (!parent || !of_device_is_compatible(parent, "qcom,pm8550") ||
+		    of_property_read_u32(np, "reg", &reg) || reg != DPM_STUCK_SDAM_BASE) {
+			of_node_put(parent);
+			continue;
+		}
+		of_node_put(parent);
+		break;
+	}
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return NULL;
+	map = dev_get_regmap(pdev->dev.parent, NULL);
+	put_device(&pdev->dev);
+	return map;
+}
+
+static bool dpm_stuck_slot_blank(const u8 *buf, unsigned int off, unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i < len; i++) {
+		if (buf[off + i] != 0x00 && buf[off + i] != 0xff)
+			return false;
+	}
+	return true;
+}
+
+/* Leave "D1CANARY" in the slot. A later boot shows whether reset keeps it. */
+static bool dpm_stuck_slot_canary(struct regmap *map, unsigned int off,
+				  unsigned int len)
+{
+	u8 buf[DPM_STUCK_SDAM_TAIL_LEN];
+	u8 chk[DPM_STUCK_SDAM_TAIL_LEN];
+
+	if (len > sizeof(buf))
+		return false;
+	memset(buf, 0, len);
+	memcpy(buf, "D1", 2);
+	strscpy(buf + 2, "CANARY", len - 2);
+	if (regmap_bulk_write(map, DPM_STUCK_SDAM_REG + off, buf, len))
+		return false;
+	if (regmap_bulk_read(map, DPM_STUCK_SDAM_REG + off, chk, len))
+		return false;
+	return !memcmp(buf, chk, len);
+}
+
+static void dpm_stuck_sdam_report(void)
+{
+	struct regmap *map;
+	u8 buf[DPM_STUCK_SDAM_LEN];
+	unsigned int size = 0;
+	unsigned int off, len;
+	int rc;
+
+	if (dpm_stuck_sdam_checked)
+		return;
+	map = dpm_stuck_sdam_map();
+	if (!map)
+		return;
+	rc = regmap_read(map, DPM_STUCK_SDAM_BASE + 0x44, &size);
+	if (rc)
+		return;
+	size *= 32;
+	if (DPM_STUCK_SDAM_OFF + DPM_STUCK_SDAM_LEN > 0x40 + size) {
+		pr_info("SDAM 0x%x size %u has no spare at 0x%x\n",
+			DPM_STUCK_SDAM_BASE, size, DPM_STUCK_SDAM_OFF);
+		dpm_stuck_sdam_checked = true;
+		return;
+	}
+	rc = regmap_bulk_read(map, DPM_STUCK_SDAM_REG, buf, DPM_STUCK_SDAM_LEN);
+	if (rc)
+		return;
+	dpm_stuck_sdam_checked = true;
+
+	if (!memcmp(buf + DPM_STUCK_SDAM_TAIL, "D1", 2)) {
+		off = DPM_STUCK_SDAM_TAIL;
+		len = DPM_STUCK_SDAM_TAIL_LEN;
+	} else if (!memcmp(buf + DPM_STUCK_SDAM_GAP, "D1", 2)) {
+		off = DPM_STUCK_SDAM_GAP;
+		len = DPM_STUCK_SDAM_GAP_LEN;
+	} else {
+		off = 0;
+		len = 0;
+	}
+	if (len) {
+		dpm_stuck_slot_off = off;
+		dpm_stuck_slot_len = len;
+		dpm_stuck_sdam_spare = true;
+		if (!strncmp(buf + off + 2, "CANARY", 6)) {
+			pr_info("SDAM tail survived reset\n");
+			return;
+		}
+		pr_emerg("previous DPM timeout: %s\n", buf + off + 2);
+		memset(buf + off, 0, len);
+		regmap_bulk_write(map, DPM_STUCK_SDAM_REG + off, buf + off, len);
+		return;
+	}
+
+	if (dpm_stuck_slot_blank(buf, DPM_STUCK_SDAM_TAIL, DPM_STUCK_SDAM_TAIL_LEN) &&
+	    dpm_stuck_slot_canary(map, DPM_STUCK_SDAM_TAIL, DPM_STUCK_SDAM_TAIL_LEN)) {
+		dpm_stuck_slot_off = DPM_STUCK_SDAM_TAIL;
+		dpm_stuck_slot_len = DPM_STUCK_SDAM_TAIL_LEN;
+		dpm_stuck_sdam_spare = true;
+		pr_info("SDAM tail write sticks\n");
+		return;
+	}
+	if (dpm_stuck_slot_blank(buf, DPM_STUCK_SDAM_GAP, DPM_STUCK_SDAM_GAP_LEN) &&
+	    dpm_stuck_slot_canary(map, DPM_STUCK_SDAM_GAP, DPM_STUCK_SDAM_GAP_LEN)) {
+		dpm_stuck_slot_off = DPM_STUCK_SDAM_GAP;
+		dpm_stuck_slot_len = DPM_STUCK_SDAM_GAP_LEN;
+		dpm_stuck_sdam_spare = true;
+		pr_info("SDAM gap write sticks\n");
+		return;
+	}
+	pr_info("SDAM tail write did not stick\n");
+	print_hex_dump(KERN_INFO, "PM: sdam ", DUMP_PREFIX_OFFSET, 16, 1,
+		       buf, DPM_STUCK_SDAM_LEN, true);
+}
+
+static void dpm_stuck_sdam_store(void)
+{
+	struct regmap *map;
+	u8 slot[DPM_STUCK_SDAM_TAIL_LEN];
+
+	if (!dpm_stuck_sdam_spare || !dpm_stuck_slot_len ||
+	    dpm_stuck_slot_len > sizeof(slot))
+		return;
+	map = dpm_stuck_sdam_map();
+	if (!map)
+		return;
+	memset(slot, 0, dpm_stuck_slot_len);
+	memcpy(slot, "D1", 2);
+	strscpy(slot + 2, dpm_stuck_msg, dpm_stuck_slot_len - 2);
+	regmap_bulk_write(map, DPM_STUCK_SDAM_REG + dpm_stuck_slot_off,
+			  slot, dpm_stuck_slot_len);
+}
+
 static int dpm_stuck_kthread(void *unused)
 {
+	sched_set_fifo(current);
 	for (;;) {
 		wait_event_interruptible(dpm_stuck_wait,
 			dpm_stuck_pending || kthread_should_stop());
@@ -619,19 +792,8 @@
 			break;
 
 		dpm_stuck_pending = 0;
-		{
-			struct file *f;
-			loff_t pos = 0;
-
-			f = filp_open("/boot/pm-stuck.txt",
-				      O_WRONLY | O_CREAT | O_TRUNC, 0644);
-			if (!IS_ERR(f)) {
-				kernel_write(f, dpm_stuck_msg,
-					     strlen(dpm_stuck_msg), &pos);
-				vfs_fsync(f, 1);
-				filp_close(f, NULL);
-			}
-		}
+		dpm_stuck_sdam_report();
+		dpm_stuck_sdam_store();
 		timer_delete_sync(&dpm_stuck_panic_timer);
 		dpm_stuck_do_panic();
 	}
@@ -641,6 +803,7 @@
 static int __init dpm_stuck_init(void)
 {
 	timer_setup(&dpm_stuck_panic_timer, dpm_stuck_panic_timer_fn, 0);
+	dpm_stuck_sdam_report();
 	dpm_stuck_task = kthread_run(dpm_stuck_kthread, NULL, "dpm-stuck");
 	if (IS_ERR(dpm_stuck_task))
 		dpm_stuck_task = NULL;
@@ -673,10 +836,10 @@
 			  "%s %s: unrecoverable failure\n",
 			  dev_driver_string(wd->dev), dev_name(wd->dev));
 		/*
-		 * The timer cannot sleep on vfat. The nofreeze thread writes
-		 * the name, then panics. If that write blocks, panic anyway.
+		 * The timer cannot touch SPMI. The nofreeze thread stores the
+		 * name in SDAM, then panics. If that store blocks, panic anyway.
 		 */
-		mod_timer(&dpm_stuck_panic_timer, jiffies + 5 * HZ);
+		mod_timer(&dpm_stuck_panic_timer, jiffies + 10 * HZ);
 		dpm_stuck_pending = 1;
 		wake_up(&dpm_stuck_wait);
 	}
