From: MaSi <masi@localhost>
Subject: [PATCH] bus: mhi: notify clients when mission mode is reached

A client left bound across power-down has to reopen its channels after
the controller is back in mission mode. Tell those drivers at that point.
--- a/drivers/bus/mhi/host/pm.c
+++ b/drivers/bus/mhi/host/pm.c
@@ -390,6 +390,21 @@
 	return 0;
 }
 
+static int mhi_child_notify_mission(struct device *dev, void *data)
+{
+	struct mhi_device *mhi_dev;
+
+	if (dev->bus != &mhi_bus_type)
+		return 0;
+
+	mhi_dev = to_mhi_device(dev);
+	if (mhi_dev->dev_type == MHI_DEVICE_CONTROLLER)
+		return 0;
+
+	mhi_notify(mhi_dev, MHI_CB_EE_MISSION_MODE);
+	return 0;
+}
+
 /* Handle device Mission Mode transition */
 static int mhi_pm_mission_mode_transition(struct mhi_controller *mhi_cntrl)
 {
@@ -464,6 +479,8 @@
 	 */
 	dev_info(dev, "Mission mode M0, creating devices\n");
 	mhi_create_devices(mhi_cntrl);
+	device_for_each_child(&mhi_cntrl->mhi_dev->dev, NULL,
+			       mhi_child_notify_mission);
 	mhi_start_event_poll(mhi_cntrl);
 
 	read_lock_bh(&mhi_cntrl->pm_lock);
